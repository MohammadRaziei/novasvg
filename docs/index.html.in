        <div>
            <div class="footer-links-title">Resources</div>
            <div class="footer-links">
                <a class="footer-link" href="https://github.com/MohammadRaziei/novasvg" target="_blank">
                    <i class="fa-brands fa-github"></i> Source code
                </a>
                <a class="footer-link" href="cpp/html/index.html">
                    <i class="fa-solid fa-book"></i> C++ reference
                </a>
                <a class="footer-link" href="python/html/index.html">
                    <i class="fa-brands fa-python"></i> Python reference
